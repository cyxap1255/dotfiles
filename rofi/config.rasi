configuration {
    modi:                       "drun,run,window";
    show-icons:                 false;
    icon-theme:                 "Papirus";
    display-drun:               "Apps";
    display-run:                "Run";
    display-window:             "Window";
    drun-display-format:        "{name}";
    font:                       "Go Mono";
}

@theme "theme.rasi"
